{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/rfontes1987/wilanis/schemas-v1/packages/core/schemas/connection.schema.json",
  "title": "connection",
  "description": "A named channel to an external system: its kind and the settings that kind judges. Values may read {{secrets.key}} and nothing else.",
  "type": "object",
  "properties": {
    "$schema": {
      "description": "The kind of this document: its published schema URL, or the alias @wilanis/connection.schema.json.",
      "enum": [
        "https://raw.githubusercontent.com/rfontes1987/wilanis/schemas-v1/packages/core/schemas/connection.schema.json",
        "@wilanis/connection.schema.json"
      ]
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "$ref": "common.schema.json#/$defs/path"
    },
    "settings": {
      "type": "object"
    }
  },
  "required": [
    "$schema",
    "description",
    "kind",
    "settings"
  ],
  "additionalProperties": false
}
