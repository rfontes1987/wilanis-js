{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/rfontes1987/wilanis-js/schemas-v1/packages/core/schemas/scenario.schema.json",
  "title": "scenario",
  "description": "One recorded run of a graph: the seed and generated input, the stubbed results of every effectful node, and the report the run produced. wilanis fuzz writes them; wilanis regress replays them and diffs node by node.",
  "type": "object",
  "properties": {
    "$schema": {
      "description": "The kind of this document: its published schema URL, or the alias @wilanis/scenario.schema.json.",
      "enum": [
        "https://raw.githubusercontent.com/rfontes1987/wilanis-js/schemas-v1/packages/core/schemas/scenario.schema.json",
        "@wilanis/scenario.schema.json"
      ]
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "graph": {
      "$ref": "common.schema.json#/$defs/path"
    },
    "seed": {
      "type": "integer"
    },
    "in": {},
    "request": {
      "type": "object"
    },
    "stubs": {
      "description": "dotted node path -> the value its operation returned.",
      "type": "object",
      "additionalProperties": {}
    },
    "expect": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "done",
            "failed",
            "blocked"
          ]
        },
        "output": {},
        "nodes": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string"
              },
              "out": {},
              "selected": {
                "type": "string"
              }
            },
            "required": [
              "status"
            ]
          }
        }
      },
      "required": [
        "status",
        "nodes"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "$schema",
    "description",
    "graph",
    "seed",
    "expect"
  ],
  "additionalProperties": false
}
