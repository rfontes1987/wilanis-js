{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/rfontes1987/wilanis-js/schemas-v1/packages/core/schemas/port.schema.json",
  "title": "port",
  "description": "A contract: named operations, each with what it accepts, what it returns, and the params fixed where it is called. A port a plugin grants is NATIVE (the plugin binds it); a port in a feature is a DOMAIN port (a binding binds it). Nodes run path#operation.",
  "type": "object",
  "properties": {
    "$schema": {
      "description": "The kind of this document: its published schema URL, or the alias @wilanis/port.schema.json.",
      "enum": [
        "https://raw.githubusercontent.com/rfontes1987/wilanis-js/schemas-v1/packages/core/schemas/port.schema.json",
        "@wilanis/port.schema.json"
      ]
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "operations": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "common.schema.json#/$defs/ident"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string",
            "minLength": 1
          },
          "accepts": {
            "$ref": "common.schema.json#/$defs/fields"
          },
          "returns": {
            "$ref": "common.schema.json#/$defs/type"
          },
          "params": {
            "$ref": "common.schema.json#/$defs/fields"
          },
          "pure": {
            "description": "True when running it changes nothing in the world. Native operations default to false.",
            "type": "boolean"
          }
        },
        "required": [
          "description"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "$schema",
    "description",
    "operations"
  ],
  "additionalProperties": false
}
