{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/rfontes1987/wilanis-js/schemas-v1/packages/core/schemas/graph.schema.json",
  "title": "graph",
  "description": "Behaviour as dataflow. A node runs when every value it reads has settled; list order carries no meaning. Node types are documents of their own: @wilanis/node/run, switch, map. Reconvergence happens at out.from: one node, or an ordered list of candidates each behind a switch.",
  "type": "object",
  "properties": {
    "$schema": {
      "description": "The kind of this document: its published schema URL, or the alias @wilanis/graph.schema.json.",
      "enum": [
        "https://raw.githubusercontent.com/rfontes1987/wilanis-js/schemas-v1/packages/core/schemas/graph.schema.json",
        "@wilanis/graph.schema.json"
      ]
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "resolvers": {
      "$ref": "common.schema.json#/$defs/resolvers"
    },
    "constants": {
      "description": "Typed literals, read as {{const.name}}.",
      "type": "object",
      "propertyNames": {
        "$ref": "common.schema.json#/$defs/ident"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "type": {
            "$ref": "common.schema.json#/$defs/type"
          },
          "value": {},
          "description": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "value"
        ],
        "additionalProperties": false
      }
    },
    "in": {
      "description": "What the graph takes, read as {{in.field}}. Absent: takes nothing.",
      "$ref": "common.schema.json#/$defs/typeRef"
    },
    "out": {
      "type": "object",
      "properties": {
        "type": {
          "$ref": "common.schema.json#/$defs/typeRef"
        },
        "from": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/ident"
            },
            {
              "type": "array",
              "items": {
                "$ref": "common.schema.json#/$defs/ident"
              },
              "minItems": 1,
              "uniqueItems": true
            }
          ]
        },
        "description": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "from"
      ],
      "additionalProperties": false
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "description": "One node. type names the node schema the rest of the object is judged by.",
        "type": "object",
        "properties": {
          "type": {
            "enum": [
              "@wilanis/node/run.schema.json",
              "@wilanis/node/switch.schema.json",
              "@wilanis/node/map.schema.json"
            ]
          }
        },
        "required": [
          "type"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "const": "@wilanis/node/run.schema.json"
                }
              }
            },
            "then": {
              "$ref": "node/run.schema.json"
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "@wilanis/node/switch.schema.json"
                }
              }
            },
            "then": {
              "$ref": "node/switch.schema.json"
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "@wilanis/node/map.schema.json"
                }
              }
            },
            "then": {
              "$ref": "node/map.schema.json"
            }
          }
        ]
      }
    }
  },
  "required": [
    "$schema",
    "description",
    "nodes"
  ],
  "additionalProperties": false
}
