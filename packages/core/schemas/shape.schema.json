{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/rfontes1987/wilanis-js/schemas-v1/packages/core/schemas/shape.schema.json",
  "title": "shape",
  "description": "A named object type. layer says who may speak it: edge shapes are what the outside world imposes and only triggers and the data layer may name them; core shapes are the project's own. unknown is legal only in edge shapes.",
  "type": "object",
  "properties": {
    "$schema": {
      "description": "The kind of this document: its published schema URL, or the alias @wilanis/shape.schema.json.",
      "enum": [
        "https://raw.githubusercontent.com/rfontes1987/wilanis-js/schemas-v1/packages/core/schemas/shape.schema.json",
        "@wilanis/shape.schema.json"
      ]
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "layer": {
      "enum": [
        "edge",
        "core"
      ]
    },
    "fields": {
      "$ref": "common.schema.json#/$defs/fields"
    },
    "open": {
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "$ref": "common.schema.json#/$defs/typeRef"
        }
      ]
    }
  },
  "required": [
    "$schema",
    "description",
    "layer",
    "fields"
  ],
  "additionalProperties": false
}
