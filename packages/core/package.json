{
  "name": "@wilanis/core",
  "version": "0.1.0",
  "description": "The wilanis document language: JSON Schemas, the TypeScript model, the type system, loader, scope and plugin contract.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Rafael Fontes <rfontes1987@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wilanis/wilanis-js.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/wilanis/wilanis-js/tree/main/packages/core#readme",
  "bugs": "https://github.com/wilanis/wilanis-js/issues",
  "keywords": [
    "wilanis",
    "dataflow",
    "json-schema",
    "declarative",
    "schemas",
    "model"
  ],
  "exports": {
