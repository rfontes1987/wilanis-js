{
  "$schema": "https://raw.githubusercontent.com/wilanis/wilanis-js/schemas-v1/packages/core/schemas/graph.schema.json",
  "label": "End the session",
  "description": "Data graph behind signOut: end the session the guard identified.",
  "resolvers": "@access/edge/session.resolvers.json",
  "out": {
    "type": "@access/edge/SignedOut.shape.json",
    "from": "ended"
  },
  "nodes": [
    {
      "type": "@wilanis/node/run.schema.json",
      "id": "ended",
      "label": "End it",
      "run": "@auth/session.port.json#end",
      "in": {
        "session": "{{sid}}"
      }
    }
  ]
}
