{
  "$schema": "https://raw.githubusercontent.com/rfontes1987/wilanis-js/schemas-v1/packages/core/schemas/shape.schema.json",
  "label": "Verification",
  "description": "What a directory said about a credential: verified with the identity, rejected, or unavailable.",
  "layer": "core",
  "fields": {
    "status": {
      "type": "string",
      "enum": [
        "verified",
        "rejected",
        "unavailable"
      ]
    },
    "identity": {
      "type": "@access/domain/Identity.shape.json",
      "required": false
    }
  }
}
