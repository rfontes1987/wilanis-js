{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wilanis.dev/schemas/1/shape.schema.json",
  "title": "shape",
  "description": "A named object type. layer says who may speak it: edge shapes are what the outside world imposes and only triggers and the data layer may name them; core shapes are the project's own. unknown is legal only in edge shapes.",
  "type": "object",
  "properties": {
    "$schema": { "const": "@wilanis/shape.schema.json" },
    "description": { "type": "string", "minLength": 1 },
    "layer": { "enum": ["edge", "core"] },
    "fields": { "$ref": "common.schema.json#/$defs/fields" },
    "open": { "oneOf": [ { "type": "boolean" }, { "$ref": "common.schema.json#/$defs/typeRef" } ] }
  },
  "required": ["$schema", "description", "layer", "fields"],
  "additionalProperties": false
}
