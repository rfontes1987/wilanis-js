// Code quality for the @wilanis/* workspace: one linter and formatter, Biome. `npm run lint` must pass.
//
// The limits below are the house rules. A function stays under 50 lines and a cognitive complexity of 10; a
// file under 300 lines; a signature takes at most 4 parameters (an options object beyond that); callbacks
// nest at most 3 deep; no nested ternaries; a name is at least 2 characters (`_` for an ignored parameter).
//
// Tests keep the same rules, except that a test body may be long, `describe`/`it` may nest, and `!` and `any`
// are fine in an assertion.
//
// The last override is the debt: directories that predate the linter. There the house rules are warnings,
// so `npm run lint` stays green while `npm run lint:debt` says what is left. When you touch a file in one of
// those directories, bring it to the rules and remove the directory from the list. Never add to the list.
{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": ["packages/*/src/**/*.ts", "packages/*/test/**/*.ts", "libraries/*/test/**/*.ts", "packages/*/bin/*.js"]
  },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 120 },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "arrowParentheses": "asNeeded",
      "trailingCommas": "all",
      "semicolons": "always"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noExcessiveCognitiveComplexity": { "level": "error", "options": { "maxAllowedComplexity": 10 } },
        "noExcessiveLinesPerFunction": { "level": "error", "options": { "maxLines": 50, "skipBlankLines": true } },
        "useMaxParams": { "level": "error", "options": { "max": 4 } }
      },
      "nursery": {
        "noExcessiveNestedCallbacks": { "level": "error", "options": { "max": 3 } }
      },
      "style": {
        "noExcessiveLinesPerFile": { "level": "error", "options": { "maxLines": 300, "skipBlankLines": true } },
        "noNestedTernary": "error",
        "noNonNullAssertion": "error",
        "useTemplate": "error",
        "useNamingConvention": {
          "level": "error",
          "options": {
            "strictCase": false,
            "conventions": [
              { "selector": { "kind": "variable" }, "match": "_|(.{2,})" },
              { "selector": { "kind": "functionParameter" }, "match": "_|(.{2,})" },
              { "selector": { "kind": "catchParameter" }, "match": "(.{2,})" },
              { "selector": { "kind": "function" }, "match": "(.{2,})" },
              { "selector": { "kind": "classMember" }, "match": "(.{2,})" },
              { "selector": { "kind": "objectLiteralProperty" }, "match": ".+" },
              { "selector": { "kind": "typeMember" }, "match": ".+" }
            ]
          }
        }
      },
      "suspicious": {
        "noExplicitAny": "error"
      }
    }
  },
  "overrides": [
    {
      // a test body is one function and describe/it nest; an assertion may use ! and any
      "includes": ["**/test/**"],
      "linter": {
        "rules": {
          "complexity": { "noExcessiveLinesPerFunction": "off" },
          "nursery": { "noExcessiveNestedCallbacks": "off" },
          "style": { "noNonNullAssertion": "off" },
          "suspicious": { "noExplicitAny": "off" }
        }
      }
    },
    {
      // the view model names a rule's branches `then` and `otherwise`; nothing awaits it
      "includes": ["packages/view/**"],
      "linter": { "rules": { "suspicious": { "noThenProperty": "off" } } }
    },
    {
      // the debt: predates the linter, rules are warnings here until each directory is cleaned
      "includes": [
        "packages/plugin-auth/**",
        "packages/plugin-http/**",
        "packages/runtime/**",
        "packages/view/**",
        "libraries/access/test/**"
      ],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": { "level": "warn", "options": { "maxAllowedComplexity": 10 } },
            "noExcessiveLinesPerFunction": { "level": "warn", "options": { "maxLines": 50, "skipBlankLines": true } },
            "useMaxParams": { "level": "warn", "options": { "max": 4 } }
          },
          "nursery": { "noExcessiveNestedCallbacks": { "level": "warn", "options": { "max": 3 } } },
          "style": {
            "noExcessiveLinesPerFile": { "level": "warn", "options": { "maxLines": 300, "skipBlankLines": true } },
            "noNestedTernary": "warn",
            "noNonNullAssertion": "warn",
            "useNamingConvention": {
              "level": "warn",
              "options": {
                "strictCase": false,
                "conventions": [
                  { "selector": { "kind": "variable" }, "match": "_|(.{2,})" },
                  { "selector": { "kind": "functionParameter" }, "match": "_|(.{2,})" },
                  { "selector": { "kind": "catchParameter" }, "match": "(.{2,})" },
                  { "selector": { "kind": "function" }, "match": "(.{2,})" },
                  { "selector": { "kind": "classMember" }, "match": "(.{2,})" },
                  { "selector": { "kind": "objectLiteralProperty" }, "match": ".+" },
                  { "selector": { "kind": "typeMember" }, "match": ".+" }
                ]
              }
            }
          },
          "suspicious": { "noExplicitAny": "warn" }
        }
      }
    }
  ]
}
