{
  "$schema": "https://raw.githubusercontent.com/rfontes1987/wilanis-js/schemas-v1/packages/core/schemas/project.schema.json",
  "label": "Monitor",
  "name": "monitor",
  "description": "A monitor of observed HTTP calls: the routes talk to a REST API (mockapi.io). Plugins come from npm packages named by \"from\". No secrets: the API is public.",
  "aliases": {
    "@monitor": "@features/monitor"
  },
  "plugins": [
    {
      "use": "@std"
    },
    {
      "use": "@cli"
    },
    {
      "use": "@http",
      "from": "@wilanis/plugin-http",
      "settings": {
        "port": 8080,
        "codecs": {
          "application/json": "@http/codecs/json.codec.json"
        }
      }
    }
  ],
  "profiles": {
    "live": {
      "description": "The real monitor API.",
      "bindings": {
        "@monitor/domain/monitor.port.json": "@monitor/data/monitor-rest.binding.json"
      }
    }
  }
}
