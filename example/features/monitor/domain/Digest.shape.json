{
  "$schema": "https://raw.githubusercontent.com/wilanis/wilanis-js/schemas-v1/packages/core/schemas/shape.schema.json",
  "label": "Digest",
  "layer": "core",
  "description": "What the digest answers: how many entries there are, and one line per entry as text.",
  "fields": {
    "count": {
      "type": "number",
      "description": "how many entries"
    },
    "text": {
      "type": "string",
      "description": "one line per entry"
    }
  }
}
