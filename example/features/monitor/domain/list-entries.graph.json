{
  "$schema": "https://raw.githubusercontent.com/wilanis/wilanis-js/schemas-v1/packages/core/schemas/graph.schema.json",
  "label": "List entries",
  "description": "Domain graph behind GET /monitor: narrowed when a method is given, everything otherwise. The two branches reconverge at out.from.",
  "in": "@monitor/domain/MethodFilter.shape.json",
  "out": {
    "type": "@monitor/domain/Entry.shape.json[]",
    "from": [
      "byMethod",
      "all"
    ]
  },
  "nodes": [
    {
      "type": "@wilanis/node/switch.schema.json",
      "id": "route",
      "label": "Is a method given?",
      "in": {
        "method": "{{in.method}}"
      },
      "rules": [
        {
          "when": "has(method)",
          "to": "byMethod"
        }
      ],
      "else": "all"
    },
    {
      "type": "@wilanis/node/run.schema.json",
      "id": "byMethod",
      "label": "Entries of that method",
      "run": "@monitor/domain/monitor.port.json#listByMethod",
      "in": {
        "method": "{{in.method}}"
      }
    },
    {
      "type": "@wilanis/node/run.schema.json",
      "id": "all",
      "label": "Every entry",
      "run": "@monitor/domain/monitor.port.json#listAll"
    }
  ]
}
