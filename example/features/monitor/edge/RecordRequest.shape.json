{
  "$schema": "https://raw.githubusercontent.com/wilanis/wilanis-js/schemas-v1/packages/core/schemas/shape.schema.json",
  "label": "Record request",
  "layer": "edge",
  "description": "POST /monitor body. Closed: an undeclared field is a 400, never a silent pass-through.",
  "fields": {
    "url": {
      "type": "string"
    },
    "method": {
      "type": "string",
      "enum": [
        "GET",
        "POST",
        "PUT",
        "PATCH",
        "DELETE"
      ]
    }
  }
}
