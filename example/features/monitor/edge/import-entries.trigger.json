{
  "$schema": "https://raw.githubusercontent.com/rfontes1987/wilanis-js/schemas-v1/packages/core/schemas/trigger.schema.json",
  "label": "POST /monitor.csv",
  "description": "POST /monitor.csv with a text/csv body (header url,method) \u2192 201 with every entry recorded, in file order. The file streams into the blob registry; the graph gets its handle. 502 as upstream when the monitor API broke.",
  "kind": "@http/http.trigger-kind.json",
  "settings": {
    "route": "/monitor.csv",
    "method": "POST",
    "consumes": "text/csv",
    "produces": "application/json",
    "access": {
      "open": true
    },
    "body": "blob",
    "response": {
      "status": {
        "default": 201
      },
      "refusals": {
        "upstream": 502
      }
    }
  },
  "in": "@monitor/edge/CsvUpload.shape.json",
  "out": "@monitor/edge/EntryView.shape.json[]",
  "fire": {
    "run": "@monitor/domain/monitor.port.json#import",
    "in": {
      "file": "{{request.body}}"
    }
  }
}
