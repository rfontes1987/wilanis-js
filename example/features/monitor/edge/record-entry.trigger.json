{
  "$schema": "https://raw.githubusercontent.com/rfontes1987/wilanis-js/schemas-v1/packages/core/schemas/trigger.schema.json",
  "label": "POST /monitor",
  "description": "POST /monitor \u2192 201 with the recorded entry. The body is the input.",
  "kind": "@http/http.trigger-kind.json",
  "settings": {
    "route": "/monitor",
    "method": "POST",
    "consumes": "application/json",
    "produces": "application/json",
    "access": {
      "open": true
    },
    "response": {
      "status": {
        "default": 201
      }
    },
    "body": "@monitor/edge/RecordRequest.shape.json"
  },
  "in": "@monitor/edge/RecordRequest.shape.json",
  "out": "@monitor/edge/EntryView.shape.json",
  "fire": {
    "run": "@monitor/domain/monitor.port.json#submit",
    "in": {
      "url": "{{request.body.url}}",
      "method": "{{request.body.method}}"
    }
  }
}
