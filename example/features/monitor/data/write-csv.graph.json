{
  "$schema": "https://raw.githubusercontent.com/rfontes1987/wilanis-js/schemas-v1/packages/core/schemas/graph.schema.json",
  "label": "Write CSV",
  "description": "Data graph behind monitor.toCsv: the entries written as monitor.csv into the blob registry; the graph answers the handle, and the route streams the file.",
  "in": "@monitor/domain/Entry.shape.json[]",
  "out": {
    "type": "blob",
    "from": "file"
  },
  "nodes": [
    {
      "type": "@wilanis/node/run.schema.json",
      "id": "file",
      "label": "Write the file",
      "run": "@blob/csv.port.json#write",
      "in": {
        "rows": "{{in}}",
        "type": "@monitor/domain/Entry.shape.json",
        "filename": "monitor.csv"
      }
    }
  ]
}
