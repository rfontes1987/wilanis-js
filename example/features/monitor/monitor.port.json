{
  "$schema": "https://raw.githubusercontent.com/rfontes1987/wilanis-js/schemas-v1/packages/core/schemas/port.schema.json",
  "description": "What the domain needs from entry storage. Bound by monitor-rest.binding.json; a test double binds the same contract.",
  "operations": {
    "listAll": {
      "description": "Every entry.",
      "returns": "@shapes/Entry.shape.json[]"
    },
    "listByMethod": {
      "description": "Entries of one HTTP method.",
      "accepts": {
        "method": {
          "type": "string"
        }
      },
      "returns": "@shapes/Entry.shape.json[]"
    },
    "get": {
      "description": "One entry by id. Fails when there is no such entry.",
      "accepts": {
        "id": {
          "type": "string"
        }
      },
      "returns": "@shapes/Entry.shape.json"
    },
    "record": {
      "description": "Store a new entry and answer it with its id.",
      "accepts": {
        "url": {
          "type": "string"
        },
        "method": {
          "type": "string",
          "enum": [
            "GET",
            "POST",
            "PUT",
            "PATCH",
            "DELETE"
          ]
        },
        "ua": {
          "type": "string"
        }
      },
      "returns": "@shapes/Entry.shape.json"
    },
    "update": {
      "description": "Replace the call of one entry. Fails when there is no such entry.",
      "accepts": {
        "id": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "method": {
          "type": "string",
          "enum": [
            "GET",
            "POST",
            "PUT",
            "PATCH",
            "DELETE"
          ]
        }
      },
      "returns": "@shapes/Entry.shape.json"
    },
    "remove": {
      "description": "Delete one entry and answer what was deleted. Fails when there is no such entry.",
      "accepts": {
        "id": {
          "type": "string"
        }
      },
      "returns": "@shapes/Entry.shape.json"
    }
  }
}
