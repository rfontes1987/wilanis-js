{
  "$schema": "https://raw.githubusercontent.com/rfontes1987/wilanis-js/schemas-v1/packages/core/schemas/graph.schema.json",
  "description": "Domain graph behind DELETE /monitor/{id}: answers the entry that was removed.",
  "in": "@shapes/EntryRef.shape.json",
  "out": {
    "type": "@shapes/Entry.shape.json",
    "from": "removed"
  },
  "nodes": [
    {
      "type": "@wilanis/node/run.schema.json",
      "id": "removed",
      "run": "@monitor/monitor.port.json#remove",
      "in": {
        "id": "{{in.id}}"
      }
    }
  ]
}
