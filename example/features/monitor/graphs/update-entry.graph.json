{
  "$schema": "https://raw.githubusercontent.com/rfontes1987/wilanis-js/schemas-v1/packages/core/schemas/graph.schema.json",
  "description": "Domain graph behind PUT /monitor/{id}: replace the call of one entry.",
  "in": "@shapes/EntryUpdate.shape.json",
  "out": {
    "type": "@shapes/Entry.shape.json",
    "from": "updated"
  },
  "nodes": [
    {
      "type": "@wilanis/node/run.schema.json",
      "id": "updated",
      "run": "@monitor/monitor.port.json#update",
      "in": {
        "id": "{{in.id}}",
        "url": "{{in.url}}",
        "method": "{{in.method}}"
      }
    }
  ]
}
