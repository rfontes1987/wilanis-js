{
  "$schema": "https://raw.githubusercontent.com/rfontes1987/wilanis-js/schemas-v1/packages/core/schemas/shape.schema.json",
  "layer": "core",
  "description": "An observed HTTP call as the domain knows it.",
  "fields": {
    "id": {
      "type": "string"
    },
    "url": {
      "type": "string"
    },
    "method": {
      "type": "string"
    },
    "ua": {
      "type": "string",
      "required": false,
      "description": "the user agent that made the call"
    }
  }
}
