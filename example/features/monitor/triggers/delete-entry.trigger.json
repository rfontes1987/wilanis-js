{
  "$schema": "https://raw.githubusercontent.com/rfontes1987/wilanis-js/schemas-v1/packages/core/schemas/trigger.schema.json",
  "description": "DELETE /monitor/{id} \u2192 the entry that was removed.",
  "settings": {
    "route": "/monitor/{id}",
    "method": "DELETE",
    "produces": "application/json",
    "access": {
      "open": true
    }
  },
  "in": "@shapes/IdRequest.shape.json",
  "input": {
    "id": "{{request.params.id}}"
  },
  "out": "@shapes/EntryView.shape.json",
  "graph": "@monitor/graphs/delete-entry.graph.json",
  "kind": "@http/http.trigger-kind.json"
}
