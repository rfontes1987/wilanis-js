{
  "$schema": "https://raw.githubusercontent.com/rfontes1987/wilanis/schemas-v1/packages/core/schemas/graph.schema.json",
  "description": "Domain graph behind POST /tasks: every new task starts in todo; the domain decides that, not the client.",
  "constants": {
    "initial": {
      "type": "string",
      "value": "todo",
      "description": "the status a task is born with"
    }
  },
  "in": "@shapes/TaskDraft.shape.json",
  "out": {
    "type": "@shapes/Task.shape.json",
    "from": "created"
  },
  "nodes": [
    {
      "type": "@wilanis/node/run.schema.json",
      "id": "created",
      "run": "@tasks/tasks.port.json#create",
      "in": {
        "title": "in.title",
        "assignee": "in.assignee",
        "status": "const.initial"
      }
    }
  ]
}
