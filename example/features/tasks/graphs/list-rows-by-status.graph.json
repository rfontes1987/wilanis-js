{
  "$schema": "@wilanis/graph.schema.json",
  "description": "Data graph behind tasks.listByStatus: one GET with a PostgREST filter, the caller's token forwarded so row-level security applies to the user; the rows when it answered 200, a failure otherwise.",
  "in": "@shapes/StatusFilter.shape.json",
  "out": {
    "type": "@shapes/Task.shape.json[]",
    "from": [
      "rows",
      "failed"
    ]
  },
  "nodes": [
    {
      "type": "@wilanis/node/run.schema.json",
      "id": "asked",
      "run": "@http/http.port.json#request",
      "params": {
        "connection": "@connections/postgres-rest.connection.json",
        "method": "GET",
        "path": "/tasks?select=id,title,status,assignee&status=eq.{{in.status}}",
        "produces": "application/json",
        "returns": "@shapes/TaskRow.shape.json[]",
        "headers": {
          "authorization": "{{caller}}"
        }
      }
    },
    {
      "type": "@wilanis/node/switch.schema.json",
      "id": "route",
      "in": {
        "status": "asked.status",
        "body": "asked.body"
      },
      "rules": [
        {
          "when": "status == 200 && has(body)",
          "to": "rows"
        }
      ],
      "else": "failed"
    },
    {
      "type": "@wilanis/node/run.schema.json",
      "id": "rows",
      "run": "@std/data.port.json#object",
      "in": {
        "value": "asked.body"
      },
      "params": {
        "type": "@shapes/TaskRow.shape.json[]"
      }
    },
    {
      "type": "@wilanis/node/run.schema.json",
      "id": "failed",
      "run": "@std/flow.port.json#fail",
      "in": {
        "values": {
          "status": "asked.status"
        }
      },
      "params": {
        "type": "@shapes/Task.shape.json[]",
        "message": "the database API answered {status}"
      }
    }
  ],
  "resolvers": {
    "caller": {
      "description": "The caller's Authorization header, as the trigger received it.",
      "run": "@std/text.port.json#format",
      "in": {
        "values": "{{request.headers}}"
      },
      "params": {
        "template": "{authorization}"
      }
    }
  }
}