{
  "$schema": "https://raw.githubusercontent.com/rfontes1987/wilanis/schemas-v1/packages/core/schemas/graph.schema.json",
  "description": "One line per task, for the nightly digest.",
  "out": { "type": "string", "from": "joined" },
  "nodes": [
    { "type": "@wilanis/node/run.schema.json", "id": "all", "run": "@tasks/tasks.port.json#listAll" },
    { "type": "@wilanis/node/map.schema.json", "id": "lines", "run": "@std/text.port.json#format", "over": "all", "bind": { "values": "" }, "params": { "template": "- {title} [{status}]" } },
    { "type": "@wilanis/node/run.schema.json", "id": "joined", "run": "@std/text.port.json#join", "in": { "parts": "lines" }, "params": { "separator": "\n" } }
  ]
}
